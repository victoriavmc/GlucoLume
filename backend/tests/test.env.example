# Entorno SINTÉTICO de las pruebas del backend (copiar a tests/test.env; ese archivo está en .gitignore).
# Ningún valor es real: dominios reservados (.invalid, .example), claves de prueba y un SMTP que no existe.
# Las pruebas no leen el .env del proyecto (GL-12): solo este archivo.
API_ENV=test
DB_HOST=localhost
DB_NAME=GlucoLume_Pruebas_SinConexion
DB_USER=test
DB_PASSWORD=test-password-sintetica
JWT_SECRET=secreto-sintetico-solo-para-pruebas-0123456789a
SESSION_SECRET=sesion-sintetica-solo-para-pruebas-01234567
API_BASE_URL=http://glucolume.local
FRONTEND_URL=http://glucolume.local
REFRESH_TOKEN_IN_BODY=true
# Correo: SMTP inexistente (.invalid no resuelve). Las pruebas de correo usan un envío simulado; nunca se conecta a este host.
SMTP_HOST=smtp.glucolume-prueba.invalid
SMTP_PORT=587
SMTP_USERNAME=prueba@glucolume-prueba.example
SMTP_PASSWORD=clave-smtp-sintetica-no-real
SMTP_FROM_NAME=GlucoLume (pruebas)
