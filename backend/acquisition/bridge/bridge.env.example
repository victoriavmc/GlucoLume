# Configuración del puente serie de Windows. NORMALMENTE no hace falta editar este archivo a mano: Instalar-Puente.bat (o
# `bridge_ctl.py setup`) pregunta todo, valida el servidor y escribe bridge.env protegido. Ver acquisition/bridge/README.md.
# bridge.env no se versiona y contiene el token: no lo compartas.

# Puerto COM del dispositivo, elegido en la instalación entre los que Windows muestra (no se asume ninguno).
# En modo AUTO no hace falta (y se deja vacío): el puente identifica el GlucoLume por USB y Bluetooth.
SERIAL_PORT=<CONFIGURAR_PUERTO_LOCAL>
# BLUETOOTH (HC-05/HC-06, 9600 baudios), USB (Arduino UNO por cable, 115200 baudios) o AUTO (busca y reconecta solo).
# La velocidad sale del medio.
SERIAL_MEDIUM=BLUETOOTH
# SERIAL_BAUDRATE=9600

# Backend: http://localhost (Nginx del compose normal), http://localhost:8000 (compose de desarrollo) o https://...
BRIDGE_API_URL=http://localhost
# Mínimo 32 caracteres; el MISMO valor que BRIDGE_TOKEN en el .env del proyecto (lo lee el backend).
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
BRIDGE_TOKEN=
# codigoDispositivo del inventario de GlucoLume que corresponde a este Arduino
BRIDGE_DEVICE_CODE=
