# Nginx del frontend GlucoLume (imagen nginx-unprivileged: escucha en 8080, sin root).
# Variables sustituidas al iniciar el contenedor: ${BACKEND_UPSTREAM}, ${DNS_RESOLVER} y ${TRUSTED_PROXY_CIDR} (el resto de $ es de Nginx).
#
# - Sirve la SPA de React: cualquier ruta que no sea un archivo devuelve index.html (react-router).
# - Reenvía /api/, /docs, /redoc y /openapi.json al backend FastAPI. La API no se publica por separado.
# - El destino se resuelve en cada consulta (resolver + variable): el frontend arranca aunque el backend todavía no esté.
#
# IP real del cliente (la usan los límites por IP de la API y la auditoría): X-Forwarded-For solo se interpreta si el pedido llega desde
# un proxy de confianza (TRUSTED_PROXY_CIDR: el proxy HTTPS del perfil "https" o el proxy del servidor). Hacia el backend siempre se
# SOBRESCRIBE con esa IP: un cliente no puede enviar una dirección propia ni encadenar valores (uvicorn confía en el primer valor).
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Esquema original del pedido: el que informa un proxy HTTPS de confianza delante o, sin proxy (o desde un cliente no confiable), el propio.
geo $realip_remote_addr $trusted_peer {
    default 0;
    ${TRUSTED_PROXY_CIDR} 1;
}
map "$trusted_peer:$http_x_forwarded_proto" $fwd_proto {
    default $scheme;
    "1:https" https;
    "1:http"  http;
}

# HSTS solo cuando el pedido original fue HTTPS (con valor vacío Nginx no envía la cabecera).
map $fwd_proto $hsts_value {
    default "";
    https   "max-age=31536000; includeSubDomains";
}

# Registro de accesos SIN la query (H-14): los enlaces de verificación, recuperación y activación llevan un token de un solo uso en
# «?token=...» y no deben quedar en los logs. Se registra la ruta ORIGINAL sin query ($log_path, tomada de $request_uri hasta el «?»): $uri no sirve
# porque try_files la reescribe a /index.html en las rutas de la SPA y el log perdería qué pantalla se pidió.
map $request_uri $log_path {
    "~^(?<ruta>[^?]*)" $ruta;
    default "-";
}
log_format sin_query '$remote_addr - [$time_local] "$request_method $log_path" $status $body_bytes_sent "$http_user_agent" rid=$request_id';

# Páginas que no deben indexarse (la SPA devuelve el mismo index.html para todas: la diferencia se hace por cabecera, no por archivo). Con valor
# vacío Nginx no envía la cabecera, igual que HSTS. Se usa $request_uri porque try_files reescribe $uri a /index.html.
map $request_uri $robots_tag {
    ~^/(app|plataforma|administracion|auth|cuenta|login|registro|verificar-correo|activar-cuenta|recuperar-contrasena|restablecer-contrasena|confirmar-correo-resultados)(/|\?|$) "noindex, nofollow";
    default "";
}

# Protección contra inundación de los endpoints de autenticación (complementa los límites de la API, que cuentan por IP y endpoint).
limit_req_zone $binary_remote_addr zone=auth_zone:10m rate=30r/s;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 1m;
    access_log /dev/stdout sin_query;

    # Cabeceras de seguridad. CSP sin 'unsafe-inline' (GL-19): React aplica los estilos en línea por CSSOM (element.style), que la CSP no
    # bloquea; sí bloquea <style> y atributos style inyectados. Verificado el 19/10/2026 con el build y la galería de componentes.
    add_header Strict-Transport-Security $hsts_value always;
    add_header X-Robots-Tag $robots_tag always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    # Compresión. Los archivos estáticos de la SPA se precomprimen al construir la imagen (gzip -9, Dockerfile) y se sirven tal cual (gzip_static:
    # 283 KB en vez de 344 KB para el JS y el CSS iniciales, sin CPU por pedido). El resto (la API, index.html) se comprime al vuelo en nivel 5 (el
    # nivel 1 por defecto deja ~20 % más de bytes). Vary: Accept-Encoding para que una caché intermedia no sirva gzip a quien no lo acepta.
    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Flujos en vivo (Server-Sent Events): muestras del Arduino (/stream) y telemetría del dispositivo (/telemetry/stream).
    # Sin buffer ni límite de lectura.
    location ~ ^/api/v1/acquisition/(telemetry/)?stream$ {
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $backend ${BACKEND_UPSTREAM};
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Request-ID $request_id;  # correlación: la API lo guarda en cada evento de auditoría (valor propio de Nginx, el del cliente se descarta)
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        add_header X-Accel-Buffering "no" always;
        add_header Strict-Transport-Security $hsts_value always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Autenticación: igual que /api/, con tope de pedidos por IP (30/s, ráfaga de 60) contra inundación y fuerza bruta masiva.
    location ^~ /api/v1/auth/ {
        limit_req zone=auth_zone burst=60 nodelay;
        limit_req_status 429;
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $backend ${BACKEND_UPSTREAM};
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Request-ID $request_id;  # correlación: la API lo guarda en cada evento de auditoría (valor propio de Nginx, el del cliente se descarta)
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location /api/ {
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $backend ${BACKEND_UPSTREAM};
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Request-ID $request_id;  # correlación: la API lo guarda en cada evento de auditoría (valor propio de Nginx, el del cliente se descarta)
        # Si hay un proxy HTTPS delante (Caddy, Nginx del host) conserva su esquema; si no, el del propio pedido.
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Swagger UI y ReDoc (FastAPI). Cargan sus scripts/estilos desde cdn.jsdelivr.net y usan un script en línea, por lo
    # que llevan su propia CSP (un add_header en la location reemplaza los del server, por eso se repiten los demás).
    location ~ ^/(docs|redoc|openapi\.json)$ {
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $backend ${BACKEND_UPSTREAM};
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Request-ID $request_id;  # correlación: la API lo guarda en cada evento de auditoría (valor propio de Nginx, el del cliente se descarta)
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        add_header Strict-Transport-Security $hsts_value always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://fastapi.tiangolo.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; worker-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;
    }

    # Recursos con hash en el nombre: cache larga e inmutable.
    location /assets/ {
        # Sin add_header propios: un add_header en la location anularía las cabeceras de seguridad del server.
        expires 1y;
        try_files $uri =404;
    }

    # index.html nunca se cachea: una versión nueva se ve al recargar.
    location = /index.html {
        expires -1;
    }

    # Un archivo que no existe (robots.txt, sitemap.xml, un .map, un .png) es un 404, no el index.html de la SPA con estado 200 («soft 404»:
    # un buscador leía HTML como si fuera robots.txt). Sin add_header propio: hereda las cabeceras de seguridad del server.
    location ~* ^(?!/api/).+\.(?:txt|xml|json|map|ico|png|jpe?g|gif|webp|svg|woff2?|webmanifest)$ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
