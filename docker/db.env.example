# Contraseña de "sa" del SQL Server en contenedor (perfil "db"). Copiar a docker/db.env (ignorado por Git) y completar.
# Mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos. No se comparte con el backend: la API debe usar
# un usuario propio con permisos limitados (DB_USER/DB_PASSWORD del .env), no sa.
MSSQL_SA_PASSWORD=
SQLCMDPASSWORD=
