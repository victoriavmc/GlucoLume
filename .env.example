# GlucoLume - variables de entorno de referencia.
# Copiar a .env localmente. Nunca colocar secretos reales en este archivo.

# Entorno. Obligatorio en la imagen Docker (sin él la API no arranca, H-07): development en desarrollo; compose.prod.yaml lo fuerza a production.
API_ENV=development

# Base de datos
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Cuenta de base propia de «lifecycle» y de los jobs de conservación (GL-03): la única que puede depurar la auditoría. Las dos o ninguna,
# distinta de DB_USER; compose.yaml no se la pasa a la API. Permisos: database/reference/GlucoLume_permisos.sql.
DB_JOBS_USER=
DB_JOBS_PASSWORD=

# Driver ODBC y certificado del servidor. Sin valor, el certificado solo se confía en development.
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=
# Validar el certificado de SQL Server sin confiar a ciegas (obligatorio en producción): certificado público del servidor en
# docker/certs/ (montado en /run/certs) y su ruta; DB_HOST debe coincidir con el nombre o la IP del certificado.
DB_SERVER_CERTIFICATE=
DB_CERTIFICATE_HOSTNAME=

# URL pública de la API (enlaces de verificación de correo). Con Docker: http://glucolume.local (ver docs/DOCKER.md)
API_BASE_URL=http://glucolume.local

# JWT - mínimo 32 caracteres
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
# Solo durante una rotación (docs/SEGURIDAD.md): el JWT_SECRET anterior; la API acepta los tokens firmados con él hasta que lo quites (7 días).
JWT_PREVIOUS_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Sesiones y autenticación
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_LOCKOUT_MINUTES=15
# Plazo para verificar una cuenta local desde su registro; vencido, la cuenta pendiente se elimina.
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# MFA TOTP (opcional). Sin MFA_ENCRYPTION_KEY, MFA queda deshabilitado.
# Clave Fernet que cifra los secretos de la verificación en dos pasos. En una instalación nueva se genera una; en una base existente
# NO se cambia: los secretos ya guardados dejarían de poder descifrarse.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# Rotación: claves anteriores separadas por coma, solo mientras se re-cifra con «python -m app.cli.mfaKeys --reencriptar».
MFA_PREVIOUS_ENCRYPTION_KEYS=
MFA_CHALLENGE_EXPIRE_MINUTES=5
MFA_ISSUER=GlucoLume

# Google OAuth/OIDC. Requiere los cuatro valores; si falta alguno, el acceso con Google queda deshabilitado.
# GOOGLE_REDIRECT_URI debe apuntar a {origen}/api/v1/auth/google/callback. Google no admite dominios .local: con la web en
# http://glucolume.local usar http://localhost/api/v1/auth/google/callback (el backend redirige /google/login a ese origen).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=

# Correo (SMTP con STARTTLS)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# Remitente visible; si se omite se usa SMTP_USERNAME
SMTP_FROM=
SMTP_FROM_NAME=GlucoLume
# Casilla que recibe las consultas del formulario de contacto de la landing (sin valor: contacto deshabilitado)
CONTACT_EMAIL=

# URL pública del frontend (destino de los botones de los correos)
FRONTEND_URL=http://glucolume.local
# VITE - variables de entorno para el frontend
VITE_API_BASE_URL=
# Adquisición física - puerto serial (USB o Bluetooth HC-06 vía puerto virtual)
SERIAL_PORT=<CONFIGURAR_PUERTO_LOCAL>
SERIAL_BAUDRATE=9600
# Puente serie de Windows (acquisition/bridge/README.md). El MISMO token va en el backend (este .env) y en el puente.
# Mínimo 32 caracteres; sin valor el backend no acepta lecturas del puente. Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
BRIDGE_TOKEN=
# Rotación sin corte: el token anterior se acepta mientras se actualiza el puente; quitarlo después.
BRIDGE_PREVIOUS_TOKEN=
# Transitorio: con un único Arduino asignado a una institución, true deja que las cuentas individuales midan con él (no cambia su propiedad).
ALLOW_INDIVIDUAL_ON_INSTITUTIONAL_DEVICE=false
# Solo las lee el puente (el backend las ignora): BLUETOOTH (9600) o USB (115200), URL del backend y código del dispositivo en el inventario.
SERIAL_MEDIUM=BLUETOOTH
BRIDGE_API_URL=http://localhost:8000
BRIDGE_DEVICE_CODE=

# ---------------------------------------------------------------------------------------------------------------
# Docker (ver docs/DOCKER.md). Todas son opcionales salvo donde se indica.
# ---------------------------------------------------------------------------------------------------------------
# Versión de las imágenes (etiqueta). Obligatoria en producción (compose.prod.yaml); en desarrollo es "dev".
GLUCOLUME_VERSION=
# Prefijo de registro si las imágenes se publican/descargan (p. ej. registro.ejemplo.com/glucolume).
GLUCOLUME_IMAGE_PREFIX=
# En Docker "localhost" es el contenedor. Con SQL Server en Windows: host.docker.internal (o la IP del equipo).
# Sin valor se usan DB_HOST y DB_PORT.
DOCKER_DB_HOST=
DOCKER_DB_PORT=
# Frontend publicado en el host: dirección (127.0.0.1 = solo local; 0.0.0.0 = red) y puerto.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=80
# Destino de /api dentro de Nginx. Por defecto backend:8000; con el backend nativo en Windows: host.docker.internal:8000
FRONTEND_BACKEND_UPSTREAM=
# Red desde la que Nginx confía en X-Forwarded-For (IP real del cliente para los límites por IP): la del proxy HTTPS delante (Caddy del
# perfil "https" o el proxy del servidor). Sin valor: 172.16.0.0/12 (redes privadas de Docker).
FRONTEND_TRUSTED_PROXY_CIDR=
# Perfil "db" (SQL Server en contenedor): edición. La contraseña de sa va en docker/db.env (ver docker/db.env.example).
MSSQL_PID=Express
# Perfil "https" de compose.prod.yaml: dominio público para el certificado automático.
GLUCOLUME_DOMAIN=
# compose.serial.yaml (Arduino en un host Linux): nodo del dispositivo y gid del grupo dialout.
SERIAL_DEVICE=/dev/ttyACM0
SERIAL_GROUP_ID=20

# Login en http://localhost:8080 (localhost: Google no admite .local; puerto FRONTEND_LOGIN_PORT) y el resto en el dominio público.
# Vacíos = sin separación. Se compilan dentro del frontend (públicos).
FRONTEND_LOGIN_ORIGIN=http://localhost:8080
FRONTEND_APP_ORIGIN=

# Ciclo de vida de las cuentas institucionales (servicio "lifecycle"; ver docs/CICLO_VIDA_CUENTAS_INSTITUCIONALES.md).
# Segundos entre revisiones de períodos de gracia vencidos (0 = desactivado) y meses de conservación de los datos personales históricos
# de InstitucionUsuario tras la baja (0 = desactivado, valor por defecto: la política de retención todavía no fue aprobada;
# 120 es una propuesta técnica a confirmar con asesoría legal).
ACCOUNT_LIFECYCLE_INTERVAL_SECONDS=3600
PERSONNEL_RETENTION_MONTHS=0

# Auditoría y seguridad (ver docs/AUDITORIA_ADMINISTRATIVA.md). Los umbrales NO bloquean a nadie: solo deciden qué patrones se señalan en la
# consola de la administración. Conservación: IP y cliente de los eventos se anulan tras AUDIT_CONTEXT_RETENTION_DAYS (0 = desactivado); los
# intentos de acceso sin cuenta identificable se eliminan tras AUDIT_ANONYMOUS_RETENTION_MONTHS (0 = desactivado); AUDIT_RETENTION_MONTHS elimina
# TODO evento vencido (0 = conservar sin límite, valor por defecto: el plazo legal todavía no fue aprobado).
AUDIT_ALERT_WINDOW_MINUTES=15
AUDIT_ALERT_FAILURES_PER_ACCOUNT=5
AUDIT_ALERT_ACCOUNTS_PER_ORIGIN=5
AUDIT_ALERT_AUTH_REJECTIONS=20
AUDIT_ALERT_VALIDATION_REJECTIONS=30
AUDIT_UNUSUAL_ORIGIN_MIN_HISTORY=5
AUDIT_CONTEXT_RETENTION_DAYS=90
AUDIT_ANONYMOUS_RETENTION_MONTHS=12
AUDIT_RETENTION_MONTHS=0
